[Unit]
Description=Chat Lab (Ollama + Lakera Guard) - laboratorio de demonstracao
After=network.target ollama.service

[Service]
Type=simple
User=chatlab
WorkingDirectory=/opt/lakera-ollama-chat-lab
EnvironmentFile=/opt/lakera-ollama-chat-lab/.env
ExecStart=/opt/lakera-ollama-chat-lab/.venv/bin/gunicorn -w 1 -b 0.0.0.0:5000 app:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

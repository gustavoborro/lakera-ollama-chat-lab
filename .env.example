# Copie este arquivo para ".env" e preencha os valores.
# NUNCA comite o arquivo ".env" (ele ja esta no .gitignore).

# --- Ollama (LLM local) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_TIMEOUT=60

# --- Lakera Guard ---
# Chave de API do Lakera Guard (https://platform.lakera.ai)
LAKERA_API_KEY=
# Opcional: ID do projeto Lakera, caso use politicas especificas de projeto
LAKERA_PROJECT_ID=
LAKERA_API_URL=https://api.lakera.ai/v2/guard
LAKERA_TIMEOUT=10
# Tambem verifica a resposta do modelo (nao so a mensagem do usuario)
LAKERA_SCREEN_OUTPUT=true
# Estado inicial do toggle ao ligar o app (pode ser alterado depois pela interface web)
LAKERA_ENABLED=true

# --- App ---
PORT=5000
